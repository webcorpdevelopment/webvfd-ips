<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <UserSecretsId>aspnet-InvoiceScanner-BFA604E6-E2F9-4597-93B6-990C6341592B</UserSecretsId>
    <AssemblyName>InvoiceScanner</AssemblyName>
    <RootNamespace>InvoiceScanner</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
