@model IEnumerable<InvoiceScanner.ViewModels.RoleViewModel>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container-fluid">
    <div class="card card-border">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">System Roles</h6>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                <i class="fas fa-plus"></i> Create New
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="rolesTable">
                    <thead>
                        <tr>
                            <th>Role Name</th>
                            <th>Permissions Count</th>
                            <th width="140px" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar rounded-circle no-thumbnail bg-light text-center me-2">
                                            <i class="fas fa-user-tag text-muted"></i>
                                        </div>
                                        <span>@role.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">@role.Permissions.Count</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" 
                                                onclick="loadRoleDetails('@role.Id', 'details')" 
                                                data-bs-toggle="tooltip" title="Details">
                                            <i class="fas fa-info-circle"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                onclick="loadRoleDetails('@role.Id', 'edit')" 
                                                data-bs-toggle="tooltip" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                onclick="confirmDelete('@role.Id', '@role.Name')" 
                                                data-bs-toggle="tooltip" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Role Modal -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-labelledby="createRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createRoleModalLabel">Create New Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createRoleForm" asp-action="Create" method="post">
                    <div class="mb-3">
                        <label for="createName" class="form-label">Role Name</label>
                        <input type="text" class="form-control" id="createName" name="Name" required placeholder="Enter role name">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitCreateForm()">Create</button>
            </div>
        </div>
    </div>
</div>

<!-- Role Details Modal -->
<div class="modal fade" id="detailsRoleModal" tabindex="-1" aria-labelledby="detailsRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsRoleModalLabel">Role Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="detailsModalContent">
                    <!-- Content will be loaded dynamically -->
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editRoleModalLabel">Edit Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="editModalContent">
                    <!-- Content will be loaded dynamically -->
                    <div class="text-center p-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $('#rolesTable').DataTable({
                responsive: true,
                columnDefs: [
                    { orderable: false, targets: 2 }
                ],
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>><"table-responsive"t><"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                language: {
                    search: "",
                    searchPlaceholder: "Search roles..."
                }
            });
            
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
        
        // Submit create form with AJAX
        function submitCreateForm() {
            var form = $('#createRoleForm');
            
            $.ajax({
                url: '@Url.Action("Create", "Roles")',
                type: 'POST',
                data: form.serialize(),
                beforeSend: function() {
                    // Show loading
                    Swal.fire({
                        title: 'Creating role...',
                        html: 'Please wait...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function(response) {
                    // Check if the response contains success flag
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Role created successfully',
                            timer: 1500
                        }).then(function() {
                            // Refresh the page or update the table
                            location.reload();
                        });
                    } else {
                        // Handle validation errors or other issues
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to create role'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred. Please try again.'
                    });
                }
            });
        }
        
        // Load role details for edit or view
        function loadRoleDetails(id, mode) {
            var url = mode === 'edit' 
                ? '@Url.Action("GetEditForm", "Roles")/' + id
                : '@Url.Action("GetDetails", "Roles")/' + id;
                
            var modalId = mode === 'edit' ? '#editRoleModal' : '#detailsRoleModal';
            var contentId = mode === 'edit' ? '#editModalContent' : '#detailsModalContent';
            
            $.ajax({
                url: url,
                type: 'GET',
                beforeSend: function() {
                    $(contentId).html('<div class="text-center p-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>');
                    $(modalId).modal('show');
                },
                success: function(response) {
                    $(contentId).html(response);
                    
                    // Initialize any select2 dropdowns if they exist
                    if ($(contentId).find('.select2').length) {
                        $(contentId).find('.select2').select2({
                            dropdownParent: $(modalId)
                        });
                    }
                },
                error: function() {
                    $(contentId).html('<div class="alert alert-danger">Failed to load role details.</div>');
                }
            });
        }
        
        // Submit edit form with AJAX
        function submitEditForm() {
            var form = $('#editRoleForm');
            
            $.ajax({
                url: '@Url.Action("Edit", "Roles")',
                type: 'POST',
                data: form.serialize(),
                beforeSend: function() {
                    // Show loading
                    Swal.fire({
                        title: 'Updating role...',
                        html: 'Please wait...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function(response) {
                    // Check if the response contains success flag
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: 'Role updated successfully',
                            timer: 1500
                        }).then(function() {
                            // Refresh the page
                            location.reload();
                        });
                    } else {
                        // Handle validation errors or other issues
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: response.message || 'Failed to update role'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred. Please try again.'
                    });
                }
            });
        }
        
        // Confirm delete with SweetAlert
        function confirmDelete(id, name) {
            Swal.fire({
                title: 'Are you sure?',
                html: `Do you want to delete role <strong>${name}</strong>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    deleteRole(id);
                }
            });
        }
        
        // Delete role with AJAX
        function deleteRole(id) {
            $.ajax({
                url: '@Url.Action("Delete", "Roles")/' + id,
                type: 'POST',
                data: { "__RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                beforeSend: function() {
                    // Show loading
                    Swal.fire({
                        title: 'Deleting role...',
                        html: 'Please wait...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Deleted!',
                            text: 'Role has been deleted.',
                            timer: 1500
                        }).then(function() {
                            // Refresh the page
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Cannot Delete',
                            text: response.message || 'This role is in use and cannot be deleted.'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An error occurred. Please try again.'
                    });
                }
            });
        }
    </script>
} 