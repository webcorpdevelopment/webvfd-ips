@model InvoiceScanner.ViewModels.RoleViewModel

@{
    ViewData["Title"] = "Delete Role";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Delete Role</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Home">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
        <li class="breadcrumb-item active">Delete</li>
    </ol>
    
    <div class="card mb-4">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-exclamation-triangle"></i> Delete Confirmation
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <h4 class="alert-heading">Warning!</h4>
                <p>Are you sure you want to delete the role "<strong>@Model.Name</strong>"?</p>
                <p class="mb-0">This action cannot be undone. Deleting this role will remove all permissions associated with it and may affect users who have this role assigned.</p>
            </div>
            
            <dl class="row">
                <dt class="col-sm-3">Role Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>
                
                <dt class="col-sm-3">Permission Count</dt>
                <dd class="col-sm-9">@Model.Permissions.Count()</dd>
            </dl>
            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="row mt-4">
                    <div class="col">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                    <div class="col text-end">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div> 