@model InvoiceScanner.ViewModels.RoleViewModel

@{
    ViewData["Title"] = "Role Details";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Role Details</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/Home">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
        <li class="breadcrumb-item active">Details</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-id-card"></i> Role: @Model.Name
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">Role Name</dt>
                <dd class="col-sm-10">@Model.Name</dd>
                
                <dt class="col-sm-2">Permission Count</dt>
                <dd class="col-sm-10">@Model.Permissions.Count()</dd>
            </dl>
            
            <h4 class="mt-4">Assigned Permissions</h4>
            
            @if (!Model.Permissions.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> This role has no permissions assigned.
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var category in Model.Permissions.GroupBy(p => p.Category))
                    {
                        <div class="col-md-12 mb-3">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">@category.Key</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        @foreach (var permission in category)
                                        {
                                            <div class="col-md-4 mb-2">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-check-circle text-success me-2"></i>
                                                    <div>
                                                        <div>@permission.Name</div>
                                                        <small class="text-muted">@permission.Description</small>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            
            <div class="row mt-4">
                <div class="col">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
                <div class="col text-end">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                </div>
            </div>
        </div>
    </div>
</div> 