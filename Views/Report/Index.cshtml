@{
    ViewData["Title"] = "Sales Report";
}

@section Styles {
    <link rel="stylesheet" href="/luno/assets/cssbundle/dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css">
    <style>
        .card-header-custom {
            background-color: #f8f9fa;
            border-bottom: 1px solid rgba(0,0,0,.125);
            padding: 1rem;
        }
        
        .filter-card {
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
            border-radius: 0.5rem;
            border: none;
            margin-bottom: 1.5rem;
        }
        
        .data-card {
            box-shadow: 0 4px 6px rgba(0,0,0,.05);
            border-radius: 0.5rem;
            border: none;
        }
        
        .report-datatable th {
            background-color: #f8f9fa;
            font-weight: 600;
            white-space: nowrap;
        }
        
        .summary-card {
            background-color: #f8f9fa;
            border-radius: 0.5rem;
            padding: 1.25rem;
            border-left: 4px solid #3f6ad8;
            margin-bottom: 1.5rem;
            display: none;
        }
        
        .summary-title {
            color: #3f6ad8;
            font-weight: 700;
            margin-bottom: 1rem;
            font-size: 1.1rem;
        }
        
        .summary-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px dashed #e9ecef;
        }
        
        .summary-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }
        
        .summary-label {
            font-weight: 600;
            color: #495057;
        }
        
        .summary-value {
            font-weight: 700;
        }
        
        .total-value {
            color: #3f6ad8;
            font-size: 1.1rem;
        }
        
        .export-btn {
            margin-left: 0.5rem;
            display: inline-flex;
            align-items: center;
        }
        
        .export-btn i {
            margin-right: 0.5rem;
        }
        
        .amount-column {
            text-align: right;
            font-family: 'Consolas', monospace;
        }
        
        .btn-filter {
            height: 40px;
            min-width: 120px;
        }
        
        .dt-buttons {
            margin-bottom: 1rem;
        }
        
        /* Custom pagination styling */
        .dataTables_paginate {
            margin-top: 1rem !important;
        }
        
        .paginate_button {
            padding: 0.375rem 0.75rem;
            border-radius: 0.25rem;
            cursor: pointer;
        }
        
        .paginate_button.current {
            background-color: #3f6ad8 !important;
            border-color: #3f6ad8 !important;
            color: white !important;
        }
        
        .paginate_button:hover:not(.current) {
            background-color: #e9ecef !important;
            border-color: #dee2e6 !important;
        }
        
        /* Loading overlay */
        .loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            border-radius: 0.5rem;
        }
        
        .spinner-container {
            text-align: center;
        }
        
        .spinner-border {
            width: 3rem;
            height: 3rem;
        }
        
        .loading-text {
            margin-top: 1rem;
            font-weight: 600;
            color: #3f6ad8;
        }
        
        /* Remove top margin from table */
        #invoicesTable_wrapper {
            margin-top: 0 !important;
        }
        
        /* Make the buttons the same size */
        .action-buttons .btn,
        .dropdown-toggle {
            min-width: 120px;
            height: 40px;
        }
        
        /* Hide export dropdown when no data */
        #exportDropdown.disabled {
            pointer-events: none;
            opacity: 0.65;
        }
    </style>
}

<div class="container-fluid">
    <!-- Filter Section -->
    <div class="card filter-card">
        <div class="card-header card-header-custom">
            <h5 class="mb-0">Sales Report Filters</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group mb-0">
                        <label for="startDate" class="form-label">Date From</label>
                        <input type="date" class="form-control" id="startDate">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group mb-0">
                        <label for="endDate" class="form-label">Date To</label>
                        <input type="date" class="form-control" id="endDate">
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-end action-buttons">
                    <button type="button" class="btn btn-primary btn-filter" id="btnSearch">
                        <i class="fa fa-search me-2"></i>Generate Report
                    </button>
                    <button type="button" class="btn btn-danger ms-2 btn-filter" id="resetButton">
                        <i class="fa fa-undo me-2"></i>Reset
                    </button>
                    <div class="dropdown ms-2">
                        <button class="btn btn-success dropdown-toggle btn-filter disabled" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-download me-2"></i>Export
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="exportDropdown">
                            <li><button type="button" class="dropdown-item" id="exportPdf"><i class="fa fa-file-pdf me-2"></i>PDF</button></li>
                            <li><button type="button" class="dropdown-item" id="exportExcel"><i class="fa fa-file-excel me-2"></i>Excel</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Summary Section (moved above the table) -->
    <div class="summary-card" id="summarySection">
        <h6 class="summary-title">SALES REPORT SUMMARY</h6>
        <div class="summary-item">
            <div class="summary-label">Total Invoices:</div>
            <div class="summary-value" id="totalInvoices">0</div>
        </div>
        <div class="summary-item">
            <div class="summary-label">Total Amount (Tax Ex):</div>
            <div class="summary-value" id="totalSubtotal">0.00</div>
        </div>
        <div class="summary-item">
            <div class="summary-label">Total Tax:</div>
            <div class="summary-value" id="totalTax">0.00</div>
        </div>
        <div class="summary-item">
            <div class="summary-label">Total Amount (Tax Inc):</div>
            <div class="summary-value total-value" id="totalAmount">0.00</div>
        </div>
    </div>
    
    <!-- Report Results -->
    <div class="card data-card position-relative">
        <div class="card-header card-header-custom d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Sales Report Results</h5>
            <div id="reportDetails" style="display: none;">
                Period: <span id="periodDisplay" class="fw-bold"></span>
            </div>
        </div>
        <div class="card-body p-3">
            <!-- Data Table -->
            <div class="table-responsive">
                <table id="invoicesTable" class="table table-striped table-bordered report-datatable" style="width:100%">
                    <thead>
                        <tr>
                            <th>Reference No</th>
                            <th>Z Number</th>
                            <th>Customer</th>
                            <th>TIN</th>
                            <th>Amount (Tax Ex)</th>
                            <th>Tax</th>
                            <th>Amount (Tax Inc)</th>
                            <th>Processed Date</th>
                            <th>Invoice Date</th>
                            <th>Fiscal Code</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data rows will be populated via AJAX -->
                    </tbody>
                </table>
            </div>
            
            <!-- Loading overlay -->
            <div class="loading-overlay" id="loadingOverlay" style="display: none;">
                <div class="spinner-container">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="loading-text">Generating Report...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        $(document).ready(function () {
            // Set default dates (past month)
            const today = new Date();
            const monthAgo = new Date();
            monthAgo.setMonth(monthAgo.getMonth() - 1);
            
            $('#endDate').val(formatDateForInput(today));
            $('#startDate').val(formatDateForInput(monthAgo));
            
            // Initialize DataTable with custom options
            var table = $('#invoicesTable').DataTable({
                "processing": true,
                "searching": true,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                "pageLength": 25,
                "ordering": true,
                "dom": '<"top"<"d-flex justify-content-between"<"#infoContainer"><"#lengthContainer"l>><"d-flex justify-content-end mt-2 mb-2"f>>rt<"bottom"<"d-flex justify-content-between"i<"#customPagination"p>>>',
                "language": {
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                    "search": "Search:",
                    "paginate": {
                        "first": '<i class="fas fa-angle-double-left"></i>',
                        "last": '<i class="fas fa-angle-double-right"></i>',
                        "next": '<i class="fas fa-angle-right"></i>',
                        "previous": '<i class="fas fa-angle-left"></i>'
                    },
                    "emptyTable": "No data available - please use the filters above to generate a report"
                },
                "columns": [
                    { "data": "referenceNumber" },
                    { "data": "zNumber" },
                    { "data": "customerName" },
                    { "data": "customerID" },
                    { 
                        "data": "totalAmountTaxEx",
                        "render": function(data) {
                            return formatCurrency(data);
                        },
                        "className": "amount-column"
                    },
                    { 
                        "data": "totalTaxAmount",
                        "render": function(data) {
                            return formatCurrency(data);
                        },
                        "className": "amount-column"
                    },
                    { 
                        "data": "totalAmountTaxInc",
                        "render": function(data) {
                            return formatCurrency(data);
                        },
                        "className": "amount-column"
                    },
                    { "data": "processedDate" },
                    { "data": "invoiceDate" },
                    { "data": "fiscalCode" }
                ],
                "initComplete": function() {
                    // Move the length selector to the custom container
                    $('#lengthContainer').html($('.dataTables_length'));
                    
                    // Move the pagination to the custom container
                    $('#customPagination').html($('.dataTables_paginate'));
                }
            });
            
            // Function to toggle export button state
            function toggleExportButton(hasData) {
                if (hasData) {
                    $('#exportDropdown').removeClass('disabled');
                } else {
                    $('#exportDropdown').addClass('disabled');
                }
            }
            
            // Initially disable export button
            toggleExportButton(false);
            
            // Generate Report Button Click
            $('#btnSearch').on('click', function() {
                generateReport();
            });
            
            // Reset Button Click
            $('#resetButton').on('click', function() {
                window.location.reload();
            });
            
            // Export to PDF - Use button click event instead of anchor
            $('#exportPdf').on('click', function() {
                exportReport('pdf');
            });
            
            // Export to Excel - Use button click event instead of anchor
            $('#exportExcel').on('click', function() {
                exportReport('excel');
            });
            
            // Function to generate report
            function generateReport() {
                const startDate = $('#startDate').val();
                const endDate = $('#endDate').val();
                
                if (!startDate || !endDate) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Date Range Required',
                        text: 'Please select both start and end dates',
                        confirmButtonColor: '#3085d6'
                    });
                    return;
                }
                
                // Show loading with SweetAlert
                Swal.fire({
                    title: 'Generating Report',
                    text: 'Please wait while we fetch your data...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                // Also show loading overlay on the table
                $('#loadingOverlay').show();
                
                // Make AJAX request
                $.ajax({
                    url: '/Report/GetInvoices',
                    type: 'POST',
                    contentType: 'application/x-www-form-urlencoded',
                    data: { startDate: startDate, endDate: endDate },
                    success: function(response) {
                        // Hide loading overlay and SweetAlert
                        $('#loadingOverlay').hide();
                        Swal.close();
                        
                        if (response.success) {
                            // Clear and reload the table with new data
                            table.clear().rows.add(response.data).draw();
                            
                            // Display the period - use the formatted dates from the response if available
                            if (response.dateRange) {
                                $('#periodDisplay').text(`${response.dateRange.from} to ${response.dateRange.to}`);
                            } else {
                                $('#periodDisplay').text(`${formatDateDisplay(startDate)} to ${formatDateDisplay(endDate)}`);
                            }
                            $('#reportDetails').show();
                            
                            // Update summary section
                            if (response.data && response.data.length > 0) {
                                updateSummary(response.summary);
                                $('#summarySection').show();
                                
                                // Enable export buttons when we have data
                                toggleExportButton(true);
                            } else {
                                $('#summarySection').hide();
                                
                                // Disable export buttons when no data
                                toggleExportButton(false);
                                
                                Swal.fire({
                                    icon: 'info',
                                    title: 'No Data Found',
                                    text: 'No sales data available for the selected date range',
                                    confirmButtonColor: '#3085d6'
                                });
                            }
                        } else {
                            // Disable export buttons on error
                            toggleExportButton(false);
                            
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.error || 'Failed to generate report',
                                confirmButtonColor: '#3085d6'
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        // Hide loading overlay and SweetAlert
                        $('#loadingOverlay').hide();
                        Swal.close();
                        
                        // Disable export buttons on error
                        toggleExportButton(false);
                        
                        console.error("XHR Status:", status);
                        console.error("Error:", error);
                        console.error("Response:", xhr.responseText);
                        
                        let errorMessage = 'Failed to generate report';
                        if (xhr.responseJSON) {
                            errorMessage = xhr.responseJSON.error || errorMessage;
                        }
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: errorMessage,
                            confirmButtonColor: '#3085d6'
                        });
                    }
                });
            }
            
            // Function to export report
            function exportReport(type) {
                const startDate = $('#startDate').val();
                const endDate = $('#endDate').val();
                
                if (!startDate || !endDate) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Date Range Required',
                        text: 'Please select both start and end dates',
                        confirmButtonColor: '#3085d6'
                    });
                    return;
                }
                
                // Check if there's data in the table
                if (table.data().count() === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Data',
                        text: 'Please generate a report first',
                        confirmButtonColor: '#3085d6'
                    });
                    return;
                }
                
                // Show loading message
                Swal.fire({
                    title: 'Exporting',
                    text: `Preparing ${type.toUpperCase()} file...`,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                        
                        // Generate export file
                        setTimeout(() => {
                            // Use direct window.open for simplicity and reliability
                            window.open(`/Report/Export${type.charAt(0).toUpperCase() + type.slice(1)}?startDate=${startDate}&endDate=${endDate}`, '_blank');
                            
                            // Close loading message after a short delay
                            setTimeout(() => {
                                Swal.close();
                            }, 1000);
                        }, 500);
                    }
                });
            }
            
            // Function to update summary
            function updateSummary(summary) {
                $('#totalInvoices').text(summary.totalCount);
                $('#totalSubtotal').text(formatCurrency(summary.totalSubtotal));
                $('#totalTax').text(formatCurrency(summary.totalTax));
                $('#totalAmount').text(formatCurrency(summary.totalAmount));
            }
            
            // Function to format currency
            function formatCurrency(value) {
                if (value === undefined || value === null) return "0.00";
                return parseFloat(value).toLocaleString('en-US', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }
            
            // Function to format date for input fields (YYYY-MM-DD)
            function formatDateForInput(date) {
                return date.toISOString().split('T')[0];
            }
            
            // Function to format date for display (DD MMM YYYY)
            function formatDateDisplay(dateString) {
                const date = new Date(dateString);
                return date.toLocaleDateString('en-GB', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                });
            }
        });
    </script>
}
