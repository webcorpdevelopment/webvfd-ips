@using Microsoft.AspNetCore.Identity;
@using InvoiceScanner.Services
@inject UserManager<ApplicationUser> UserManager
@inject IPermissionService PermissionService

@{
    var user = UserManager.GetUserAsync(User).Result;
    var roles = UserManager.GetRolesAsync(user).Result;
    
    var hasViewDashboardPermission = await PermissionService.UserHasPermissionAsync("Dashboard.View");
    var hasUploadInvoicesPermission = await PermissionService.UserHasPermissionAsync("Invoice.Create");
    var hasViewInvoicesPermission = await PermissionService.UserHasPermissionAsync("Invoice.View");
    var hasZReportPermission = await PermissionService.UserHasPermissionAsync("Invoice.ZReport");
    var hasReportViewPermission = await PermissionService.UserHasPermissionAsync("Report.View");
    var hasViewBusinessesPermission = await PermissionService.UserHasPermissionAsync("Business.View");
    var hasViewUsersPermission = await PermissionService.UserHasPermissionAsync("User.View");
    var hasViewLogsPermission = await PermissionService.UserHasPermissionAsync("System.View");
    var hasViewCompanySettingsPermission = await PermissionService.UserHasPermissionAsync("CompanySetting.View");
    var hasViewExchangeRatePermission = await PermissionService.UserHasPermissionAsync("ExchangeRate.View");
    var hasManagePermissionsPermission = await PermissionService.UserHasPermissionAsync("Permission.Manage");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Invoice validation gateway">
    <meta name="keyword" content="efd, vfd, tra, invoice, tanzania, receipt">
    <link rel="icon" href="assets/img/favicon.ico" type="image/x-icon"> <!-- Favicon-->
    <title>@ViewData["Title"] - WebVFD IPS</title>
    <!-- Application vendor css url -->

    <!-- Application vendor css url -->
    <link rel="stylesheet" href="~/luno/assets/cssbundle/dataTables.min.css">

    <!-- project css file  -->
    <link rel="stylesheet" href="~/luno/assets/css/luno-style.css">
    <!-- Font Awesome CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- Jquery Core Js -->
    <script src="~/luno/assets/js/plugins.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="layout-1" data-luno="theme-blue">
    <!-- start: sidebar -->
    <div class="sidebar p-2 py-md-3 @@cardClass dark">
        <div class="container-fluid">
            <!-- sidebar: title-->
            <div class="title-text d-flex align-items-center mb-4 mt-1">
                <h4 class="sidebar-title mb-0 flex-grow-1"><span class="sm-txt">WebVFD  </span><span>IPS</span></h4>
            </div>
            <!-- sidebar: menu list -->
            <div class="main-menu flex-grow-1">

                <ul class="menu-list">
                    <li class="divider py-2 lh-sm"><span class="small text-white">MAIN</span></li>
                    @if (hasViewDashboardPermission)
                    {
                        <li class="collapsed">
                            <a class="m-link" asp-controller="Home" asp-action="Index">
                                <i class="fa fa-home"></i>
                                <span class="ms-2">Dashboard</span>
                            </a>
                        </li>
                    }
                </ul>

                @if (!roles.Contains("Administrator"))
                {
                    <ul class="menu-list">
                        <li class="divider py-2 lh-sm"><span class="small text-white">SALES</span></li>
                        @if (hasUploadInvoicesPermission)
                        {
                            <li class="collapsed">
                                <a class="m-link" asp-controller="Invoices" asp-action="Upload">
                                    <i class="fa fa-upload"></i>
                                    <span class="ms-2">Upload invoices</span>
                                </a>
                            </li>
                        }
                        @if (hasViewInvoicesPermission)
                        {
                            <li class="collapsed">
                                <a class="m-link" asp-controller="Invoices" asp-action="Index">
                                    <i class="fa fa-file"></i>
                                    <span class="ms-2">Invoices</span>
                                </a>
                            </li>
                            
                            <li class="collapsed">
                                <a class="m-link" asp-controller="Invoices" asp-action="InvoiceStore">
                                    <i class="fa fa-store"></i>
                                    <span class="ms-2">Invoice Store</span>
                                </a>
                            </li>
                        }
                        @if (hasZReportPermission)
                        {
                            <li class="collapsed">
                                <a class="m-link" asp-controller="Invoices" asp-action="SelectDate">
                                    <i class="fa fa-bar-chart-o"></i>
                                    <span class="ms-2">Z Report</span>
                                </a>
                            </li>
                            <li class="collapsed">
                                <a class="m-link" asp-controller="Invoices" asp-action="SelectDates">
                                    <i class="fa fa-list-alt"></i>
                                    <span class="ms-2">Z Report Summary</span>
                                </a>
                            </li>
                        }
                        @if (hasReportViewPermission)
                        {
                            <li class="collapsed">
                                <a class="m-link" asp-controller="Report" asp-action="Index">
                                    <i class="fa fa-bar-chart-o"></i>
                                    <span class="ms-2">Sales Report</span>
                                </a>
                            </li>
                        }
                    </ul>
                }

                @if (hasViewBusinessesPermission && !roles.Contains("Administrator"))
                {
                    <ul class="menu-list">
                        <li class="divider py-2 lh-sm"><span class="small text-white">SETUP</span></li>
                        <li class="collapsed">
                            <a class="m-link" asp-controller="Businesses" asp-action="Index">
                                <i class="fa fa-bookmark-o"></i>
                                <span class="ms-2">Businesses</span>
                            </a>
                        </li>
                    </ul>
                }
                
                @if (hasViewUsersPermission)
                {
                    <ul class="menu-list">
                        <a class="m-link" asp-controller="Users" asp-action="Index">
                            <i class="fa fa-users"></i>
                            <span class="ms-2">Users</span>
                        </a>
                    </ul>
                }

                <ul class="menu-list">
                    <li class="divider py-2 lh-sm"><span class="small text-white">ADMINISTRATION</span></li>
                   
                        <li class="collapsed">
                            <a class="m-link" asp-controller="Logs" asp-action="Index">
                                <i class="fa fa-list"></i>
                                <span class="ms-2">Logs</span>
                            </a>
                        </li>
                    
                    
                    @if (hasManagePermissionsPermission)
                    {
                        <li class="collapsed">
                            <a class="m-link" asp-controller="Roles" asp-action="Index">
                                <i class="fa fa-lock"></i>
                                <span class="ms-2">Roles</span>
                            </a>
                        </li>
                    }
                    
                    @if (roles.Contains("Administrator"))
                    {
                        <li class="collapsed">
                            <a class="m-link" asp-controller="Settings" asp-action="Index">
                                <i class="fa fa-cogs"></i>
                                <span class="ms-2">Settings</span>
                            </a>
                        </li>
                    }
                    
                    @if (hasViewCompanySettingsPermission && user.BusinessId.HasValue)
                    {
                        <li class="collapsed">
                            <a class="m-link" asp-controller="CompanySetting" asp-action="Index">
                                <i class="fa fa-list-alt"></i>
                                <span class="ms-2">Company Settings</span>
                            </a>
                        </li>
                    }
                    
                    <!-- @if (hasViewExchangeRatePermission && !roles.Contains("Administrator") && !roles.Contains("Business Administrator"))
                    {
                        <li class="collapsed">
                            <a class="m-link" asp-controller="ExchangeRate" asp-action="Index">
                                <i class="fa fa-list-alt"></i>
                                <span class="ms-2">Exchange Rates</span>
                            </a>
                        </li>
                    } -->
                </ul>
            </div>
            <!-- sidebar: footer link -->
        </div>
    </div>
    <!-- start: body area -->
    <div class="wrapper">
        <!-- start: page header -->
        <header class="page-header sticky-top px-xl-4 px-sm-2 px-0 py-lg-2 py-1">
            <div class="container-fluid">
                <nav class="navbar">
                    <!-- start: toggle btn -->
                    <div class="d-flex">
                        <button type="button" class="btn btn-link d-none d-xl-block sidebar-mini-btn p-0 text-primary">
                            <span class="hamburger-icon">
                                <span class="line"></span>
                                <span class="line"></span>
                                <span class="line"></span>
                            </span>
                        </button>
                        <button type="button" class="btn btn-link d-block d-xl-none menu-toggle p-0 text-primary">
                            <span class="hamburger-icon">
                                <span class="line"></span>
                                <span class="line"></span>
                                <span class="line"></span>
                            </span>
                        </button>
                        @*<a href="index.html" class="brand-icon d-flex align-items-center mx-2 mx-sm-3 text-primary">
                            <img src="~/img/logo.png" height="32" />
                            </a>*@
                    </div>
                    <!-- start: link -->
                    <ul class="header-right justify-content-end d-flex align-items-center mb-0">
                        <!-- start: full screen toggle -->
                        <li class="d-none d-xl-inline-block">
                            <a class="nav-link fullscreen" href="javascript:void(0);" onclick="toggleFullScreen(documentElement)">
                                <svg viewBox="0 0 16 16" width="18px" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
