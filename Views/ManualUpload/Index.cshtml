@{
    ViewData["Title"] = "Upload manually";
}

@section Styles {
    <!-- Dropzone css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.css" integrity="sha512-jU/7UFiaW5UBGODEopEqnbIAHOI8fO6T99m7Tsmqs2gkdujByJfkCbbfPSN4Wlqlb9TGnsuC0YgUgWkRBK7B9A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    


    <style>
        .dropify-wrapper {
            height: 10%;
        }
        .card {
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            border-radius: 8px;
            border: none;
            margin-bottom: 20px;
        }
        .card-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid rgba(0,0,0,0.125);
            padding: 1rem 1.5rem;
        }
        .btn-primary {
            background-color: #5b73e8;
            border-color: #5b73e8;
        }
        .btn-primary:hover {
            background-color: #4a5fd0;
            border-color: #4a5fd0;
        }
        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
        }
        .btn-secondary:hover {
            background-color: #5a6268;
            border-color: #545b62;
        }
        .btn-success {
            background-color: #34c38f;
            border-color: #34c38f;
        }
        .btn-success:hover {
            background-color: #2ca67a;
            border-color: #2ca67a;
        }
        .page-header {
            margin-bottom: 1.5rem;
        }
        .page-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #5b73e8;
        }
        .nav-buttons {
            margin-bottom: 1rem;
        }
    </style>
}

<!-- Page header with navigation -->
<div class="row page-header">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="page-title">Manual Invoice Upload</h4>
            <div class="nav-buttons">
                <a href="/Invoices/Upload" class="btn btn-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Auto Upload
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-upload mr-2"></i>Upload Invoice Files</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Drop invoice files below or click to browse</p>
                <div id="documents" class="dropzone"></div>
                <div id="feedback"></div>
                <div id="spinnerContainer1" class="text-center mt-3"></div>
            </div>
        </div>
    </div>
</div>
<hr />

<div class="row" id="invoiceContainer" style="display:none">
    <div class="col-md-12 mt-3">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-edit mr-2"></i>Invoice Information</h5>
            </div>
            <div class="card-body">
                <form id="invoiceForm">
                    <div class="form">
                        <h4 class="mb-3">Customer Information</h4>
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label for="buyerRegisterName">Customer Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="buyerRegisterName">
                            </div>
                            <div class="form-group col-md-4">
                                <label for="tin">Customer TIN </label>
                                <input type="text" class="form-control" id="buyerTIN">
                            </div>
                        </div>
                        <hr />

                        <h4 class="mb-3">Invoice Information</h4>
                        <div class="row">
                            <div class="form-group col-md-4">
                                <label for="invoiceNo">Invoice No <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="invoiceNo">
                            </div>
                            <div class="form-group col-md-4">
                                <label for="date">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="date">
                            </div>
                            <div class="form-group col-md-4">
                                <label for="currency">Currency <span class="text-danger">*</span></label>
                                <select class="form-control" id="currency">
                                    <option value="TZS">TZS</option>
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                </select>
                            </div>
                            <div class="form-group col-md-4" id="exchangeRateGroup" style="display:none;">
                                <label for="exchangeRate">Exchange Rate <span class="text-danger">*</span></label>
                                <input type="number" step="0.0001" class="form-control" id="exchangeRate" placeholder="Enter exchange rate to TZS">
                                <small class="form-text text-muted">Rate to convert to TZS (e.g., 1 USD = ? TZS)</small>
                            </div>
                            <div class="form-group col-md-4">
                                <label for="currency">Template type <span class="text-danger">*</span></label>
                                <select class="form-control" id="templateType">
                                    <option value="Horizontal">Horizontal</option>
                                    <option value="Vertical">Vertical</option>
                                </select>
                            </div>
                            <div class="form-group col-md-4">
                                <label for="total">Total</label>
                                <input type="text" class="form-control" id="total" readonly>
                            </div>
                            <div class="form-group col-md-4">
                                <label for="tax">TAX</label>
                                <input type="text" class="form-control" id="tax" readonly>
                                <input type="hidden" class="form-control" id="filename" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-check-circle mr-1"></i> Process Invoice
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <hr />

    <div class="col-md-12 mt-3">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-list mr-2"></i>Invoice Items</h5>
                <button id="addItemBtn" class="btn btn-success">
                    <i class="fas fa-plus mr-1"></i> Add Item
                </button>
            </div>
            <div class="card-body">
                <div id="itemModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="itemModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="itemModalLabel">Add Item</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="hideMode()">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <form id="itemForm">
                                    <div class="form-group">
                                        <label for="itemName">Name <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="itemName" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="itemQty">QTY <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control" id="itemQty" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="itemAmountTaxable">Amount Taxable <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control" id="itemAmountTaxable" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="itemTaxGroup">Tax Group <span class="text-danger">*</span></label>
                                        <select class="form-control" id="itemTaxGroup">
                                            <option value="A">A</option>
                                            <option value="C">C</option>
                                            <option value="E">E</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="TaxTypeIncl">Taxable<span class="text-danger">*</span></label>
                                        <select class="form-control" id="TaxTypeIncl">
                                            <option value="Yes">Yes</option>
                                            <option value="No">No</option>
                                        </select>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" onclick="hideMode()">Close</button>
                                        <button type="button" id="addItemToTable" class="btn btn-primary">Add Item</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="itemTable" class="mt-3" style="display: block;">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>QTY</th>
                                    <th>Unit Price</th>
                                    <th>Amount</th>
                                    <th>Tax</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="itemTableBody">
                                <!-- Items will be added here dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for the progress dialog -->
<div class="modal fade" id="progressModal" tabindex="-1" role="dialog" aria-labelledby="progressModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="progressModalLabel">Processing</h5>
                <!-- Optionally add a close button here -->
            </div>
            <div class="modal-body">
                <!-- Add a loading indicator or text here -->
                <div class="spinner-border text-primary " style="text-align:center"  role="status">
                    <span class="sr-only">Loading...</span>
                </div>
                <p>Processing your request. Please wait...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Plugin Js -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.js" integrity="sha512-U2WE1ktpMTuRBPoCFDzomoIorbOyUv0sP8B+INA3EzNAhehbzED1rOJg6bCqPf/Tuposxb5ja/MAUnC8THSbLQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        // Immediately disable Dropzone auto-discovery as soon as the script loads
        if (typeof Dropzone !== 'undefined') {
            Dropzone.autoDiscover = false;
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>

    <script>
        Dropzone.autoDiscover = false;
        const items = [];
        let itemIndex = 1;
        let myDropzone;
        
        $(document).ready(function() {
            document.getElementById("invoiceContainer").style.display = "none";
            
            // Check if the dropzone element exists
            if ($("#documents").length > 0) {
                // Initialize Dropzone
                initializeDropzone();
            }
            
            // Handle currency change to show/hide exchange rate field
            $("#currency").on("change", function() {
                const selectedCurrency = $(this).val();
                if (selectedCurrency !== "TZS") {
                    $("#exchangeRateGroup").show();
                } else {
                    $("#exchangeRateGroup").hide();
                    $("#exchangeRate").val("");
                }
            });

        function initializeDropzone() {
            try {
                console.log("Starting dropzone initialization");
                var dropzoneElement = document.getElementById("documents");
                if (!dropzoneElement) {
                    console.error("Dropzone element not found!");
                    return null;
                }
                
                                myDropzone = new Dropzone("#documents", {
                    url: "/ManualUpload/UploadFiles",
                    method: "POST",
                    paramName: "file",
                    autoProcessQueue: true,
                    acceptedFiles: ".jpg, .jpeg, .png, .gif, .pdf",
                    maxFiles: 1,
                    maxFilesize: 20, // MB
                    uploadMultiple: false,
                    parallelUploads: 1,
                    timeout: 120000,
                    dictRemoveFileConfirmation: "Are you Sure?",
                    dictFileTooBig: "File is too big ({{filesize}}mb). Max allowed file size is {{maxFilesize}}mb",
                    dictInvalidFileType: "Invalid File Type",
                    dictCancelUpload: "Cancel",
                    dictRemoveFile: "Remove",
                    dictDefaultMessage: "<i class='fas fa-cloud-upload-alt fa-3x mb-2'></i><br>Drop invoice file here or click to upload",
                });
                
                console.log("Dropzone instantiated");
                
                myDropzone.on("sending", function (file, xhr, formData) {
                    try {
                        // Show loading spinner
                        $("#spinnerContainer1").html('<div class="spinner-border text-primary" role="status"><span class="sr-only">Loading...</span></div>');
                    } catch (error) {
                        console.error("Error in sending event:", error);
                        $("#spinnerContainer1").empty();
                    }
                });

                myDropzone.on("success", function (file, response) {
                    try {
                        console.log("Upload successful, processing response");
                        $("#spinnerContainer1").empty();
                        console.log("Response:", response);
                        
                        if (response && response.status === "success") {
                            document.getElementById("invoiceContainer").style.display = "block";
                            document.getElementById("filename").value = response.filename;
                            
                            // If response contains invoice data, populate the form
                            if (response.invoice) {
                                populateInvoiceData(response.invoice);
                            }
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Error uploading file',
                            });
                        }
                    } catch (error) {
                        console.error("Error in success event:", error);
                        $("#spinnerContainer1").empty();
                    }
                });

                myDropzone.on("error", function (file, errorMessage, xhr) {
                    try {
                        console.error("Upload error:", errorMessage);
                        $("#spinnerContainer1").empty();
                        Swal.fire({
                            icon: 'error',
                            title: 'Upload Error',
                            text: typeof errorMessage === 'string' ? errorMessage : 'Error uploading file',
                            timer: 3000,
                            showConfirmButton: false
                        });
                    } catch (error) {
                        console.error("Error in error event handler:", error);
                        $("#spinnerContainer1").empty();
                    }
                });

                return myDropzone;
            } catch (error) {
                console.error("Error initializing Dropzone:", error);
                return null;
            }
        }

        // Event handlers
        $("#invoiceForm").submit(function (e) {
                $('#progressModal').modal('show');

                e.preventDefault(); // Prevent the default form submission

                // Get form data
                var formData = {
                    buyerRegisterName: $("#buyerRegisterName").val(),
                    buyerTIN: $("#buyerTIN").val(),
                    invoiceNo: $("#invoiceNo").val(),
                    date: $("#date").val(),
                    currency: $("#currency").val(),
                    total: $("#total").val(),
                    tax: $("#tax").val(),
                    filename: $("#filename").val(),
                    items: items,
                    templateType: $("#templateType").val(),
                    exchangeRate: $("#exchangeRate").val() || 0, // Include exchange rate
                };

                // Send the data to the controller using AJAX
                $.ajax({
                    type: "POST",
                    url: "/ManualUpload/ProcessInvoice",
                    data: formData,
                    success: function (response) {
                        if (response.status == 'success') {
                                $('#progressModal').modal('hide');
                            const form = document.getElementById('invoiceForm');
                            form.reset();
                            document.getElementById("invoiceContainer").style.display = "none";
                            if (myDropzone) {
                                myDropzone.removeAllFiles(true);
                            }

                            $('#itemTableBody').empty();
                            items.length = 0; // Clear items array
                            itemIndex = 1;  // Reset index counter
                            
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.message,
                            });
                        } else {
                            $('#progressModal').modal('hide');
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message,
                            });
                        }
                    },
                    error: function (error) {
                        $('#progressModal').modal('hide');
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong. Please try again.',
                        });
                    }
                });
            });

            // Add item button
            document.getElementById("addItemBtn").addEventListener("click", function () {
                $('#itemModal').modal('show');
            });

            // Add item to table
            document.getElementById("addItemToTable").addEventListener("click", function () {
                var itemName = document.getElementById("itemName").value;
                var itemQty = document.getElementById("itemQty").value;
                var itemAmountTaxable = document.getElementById("itemAmountTaxable").value;
                var itemTaxGroup = document.getElementById("itemTaxGroup").value;
                var taxTypeIncl = document.getElementById("TaxTypeIncl").value;

                if (!itemName || !itemQty || !itemAmountTaxable) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Please fill in all required fields',
                    });
                    return;
                }

                // Check if exchange rate is needed
                const selectedCurrency = $("#currency").val();
                let exchangeRate = 1; // Default for TZS
                
                if (selectedCurrency !== "TZS") {
                    const exchangeRateValue = parseFloat($("#exchangeRate").val());
                    if (!exchangeRateValue || exchangeRateValue <= 0) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Please enter a valid exchange rate',
                        });
                        return;
                    }
                    exchangeRate = exchangeRateValue;
                }

                // Parse values
                let amount = parseFloat(itemAmountTaxable);
                const qty = parseFloat(itemQty);
                
                // Calculate tax before conversion
                let itemTax = taxTypeIncl === 'Yes' ? (amount * 0.18) : 0;
                
                // Apply conversion if needed
                if (selectedCurrency !== "TZS") {
                    amount = amount * exchangeRate;
                    itemTax = itemTax * exchangeRate;
                }
                
                const itemUnitPrice = amount / qty;
                const grossUnitPrice = amount + itemTax;

                var itemTableBody = document.getElementById("itemTableBody");
                var row = document.createElement("tr");
                row.innerHTML = `
                    <td>${itemName}</td>
                    <td>${qty}</td>
                    <td>${itemUnitPrice.toFixed(2)}</td>
                    <td>${amount.toFixed(2)}</td>
                    <td>${itemTax.toFixed(2)}</td>
                    <td>
                        <button class="btn btn-sm btn-danger" onclick="removeItem(${itemIndex})">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </td>
                `;
                itemTableBody.appendChild(row);

                // Add the item to the array (already converted values)
                var item = {
                    index: itemIndex,
                    name: itemName,
                    quantity: qty,
                    amount: parseFloat(amount.toFixed(2)),
                    tax: parseFloat(itemTax.toFixed(2)),
                    unitPrice: parseFloat(itemUnitPrice.toFixed(2)),
                    grossUnitPrice: parseFloat(grossUnitPrice.toFixed(2)),
                    code: itemTaxGroup
                };
                items.push(item);
                itemIndex++;

                // Calculate total and tax (values are already converted)
                var total = 0;
                var tax = 0;
                for (var i = 0; i < items.length; i++) {
                    total += items[i].grossUnitPrice * items[i].quantity;
                    tax += items[i].tax;
                }
                document.getElementById("total").value = total.toFixed(2);
                document.getElementById("tax").value = tax.toFixed(2);

                // Reset the form and hide the modal
                document.getElementById("itemForm").reset();
                $('#itemModal').modal('hide');
            });
        });

        function hideMode() {
            $('#itemModal').modal('hide');
        }

        function removeItem(index) {
            // Remove the item from the array
            for (var i = 0; i < items.length; i++) {
                if (items[i].index === index) {
                    items.splice(i, 1);
                    break;
                }
            }

            // Rebuild the table
            var itemTableBody = document.getElementById("itemTableBody");
            itemTableBody.innerHTML = "";
            for (var i = 0; i < items.length; i++) {
                var row = document.createElement("tr");
                row.innerHTML = `
                    <td>${items[i].name}</td>
                    <td>${items[i].quantity}</td>
                    <td>${items[i].unitPrice.toFixed(2)}</td>
                    <td>${items[i].amount.toFixed(2)}</td>
                    <td>${items[i].tax.toFixed(2)}</td>
                    <td>
                        <button class="btn btn-sm btn-danger" onclick="removeItem(${items[i].index})">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </td>
                `;
                itemTableBody.appendChild(row);
            }

            // Recalculate total and tax
            var total = 0;
            var tax = 0;
            for (var i = 0; i < items.length; i++) {
                total += items[i].grossUnitPrice;
                tax += items[i].tax;
            }
            document.getElementById("total").value = total.toFixed(2);
            document.getElementById("tax").value = tax.toFixed(2);
        }
        
        // Function to populate invoice data if received from server
        function populateInvoiceData(invoice) {
            if (invoice) {
                // Set basic invoice details
                if (invoice.number) document.getElementById("invoiceNo").value = invoice.number;
                if (invoice.customer) document.getElementById("buyerRegisterName").value = invoice.customer;
                if (invoice.tin) document.getElementById("buyerTIN").value = invoice.tin;
                if (invoice.currency) {
                    document.getElementById("currency").value = invoice.currency;
                    // Trigger change event to show/hide exchange rate field
                    $("#currency").trigger("change");
                }
                
                // DO NOT populate total and tax - they are calculated when items are added
                // DO NOT populate items - let user add them manually
                
                // Set date if available
                if (invoice.date) {
                    const invoiceDate = new Date(invoice.date);
                    if (!isNaN(invoiceDate.getTime())) {
                        const formattedDate = invoiceDate.toISOString().split('T')[0];
                        document.getElementById('date').value = formattedDate;
                    }
                }
                
                // Items will be added by the user using the "Add Item" button
                // Total and tax will be calculated automatically as items are added
            }
        }
    </script>
}
