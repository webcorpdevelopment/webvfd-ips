@model InvoiceScanner.Models.ExchangeRate

@{
    ViewData["Title"] = "";

}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3>Create Exchange Rate</h3>
            </div>
            <div class="card-body ">


                <form asp-action="Edit" method="post">
                    <div class="row">
                        <div class="form-group col-sm-4 mb-2">
                            <label asp-for="RateAmount">Exchange Rate Amount</label>
                            <input type="number" asp-for="RateAmount" class="form-control" />
                            <span asp-validation-for="RateAmount" class="text-danger"></span>
                        </div>

                        <div class="form-group col-sm-4 mb-2">
                            <label asp-for="StartDate">Start Date</label>
                            <input asp-for="StartDate" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="form-group col-sm-4 mb-2">
                            <label asp-for="EndDate">End Date</label>
                            <input asp-for="EndDate" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                        <div class="form-group col-sm-4 mb-2">
                            <label asp-for="TemplateType" class="control-label">Template Type</label>
                            <select asp-for="TemplateType" class="form-control">
                                <option value="Horizontal">Horizontal</option>
                                <option value="Vertical">Vertical</option>
                            </select>
                        </div>

                        <div class="form-group col-sm-4 mb-2">
                            <label asp-for="RateName" class="control-label">Rate Name</label>
                            <select asp-for="RateName" class="form-control">
                                <option value="USD">USD</option>
                                <option value="EURO">EURO</option>
                            </select>
                        </div>
                    </div>
                   
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Update</button>
                    </div>
                </form>

            </div>
        </div>        
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
