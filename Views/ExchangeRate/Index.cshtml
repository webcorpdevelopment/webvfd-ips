@model IEnumerable<InvoiceScanner.Models.ExchangeRate>

@{
    ViewData["Title"] = "Exchange rates";
    ViewData["Subtitle"] = "List of all exchange rates";
}

<div class="card">
    <div class="card-body">
        <div class="text-end">
            <a asp-action="Create" class="btn btn-success">Create New</a>
        </div>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Template</th>
                    <th>
                        Rate Amount
                    </th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Actions</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td> @item.RateName</td>
                        <td> @item.TemplateType</td>
                        <td> @item.RateAmount</td>

                        <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> 
                            <button class="btn btn-danger"  onclick="confirmDelete('@item.Id')" >Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- Sweet Alerts js -->
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function confirmDelete(itemId) {
            // Display a confirmation dialog using a modal or JavaScript confirm
            if (confirm("Are you sure you want to delete this item?")) {
                // If the user confirms, call the deleteRate function with the item's ID
                deleteRate(itemId);
            }
        }

        function deleteRate (exchangeRateId){

            $.ajax({
                type: "POST",
                url: "/ExchangeRate/DeleteConfirmed/" + exchangeRateId,
                success: function (data) {
                    if (data.success) {
                        // Success: Show a success message and redirect or update the page as needed.
                        alert(data.message);
                        window.location.href = "/ExchangeRate/Index"; // Redirect to the index page.
                    } else {
                        // Failure: Show an error message.
                        alert(data.message);
                    }
                },
                error: function () {
                    // Error: Show an error message.
                    alert("An error occurred while deleting the exchange rate.");
                }
            });
        }
    </script>
}

