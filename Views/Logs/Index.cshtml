@using Microsoft.AspNetCore.Identity;
@inject UserManager<ApplicationUser> UserManager

@model List<InvoiceScanner.Invoice>

@{
    var user = UserManager.GetUserAsync(User).Result;
    var roles = UserManager.GetRolesAsync(user).Result;
    ViewData["Title"] = "System Logs";
    
    var isAdmin = roles.Contains("Administrator");
    int currentPage = ViewBag.CurrentPage;
    int pageSize = ViewBag.PageSize;
    int totalPages = ViewBag.TotalPages;
    int totalRecords = ViewBag.TotalRecords;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        .pagination .page-item.active .page-link {
            background-color: #5b73e8;
            border-color: #5b73e8;
        }
        .pagination .page-link {
            color: #5b73e8;
        }
        .table th a {
            color: #495057;
            text-decoration: none;
        }
        .table th a:hover {
            color: #5b73e8;
            text-decoration: underline;
        }
        .badge {
            font-size: 85%;
        }
    </style>
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4><i class="fas fa-history me-2"></i>System Logs</h4>
                <span class="badge bg-info">@totalRecords Total Records</span>
            </div>
            <div class="card-body">
                <form method="get" action="@Url.Action("Index", "Logs")" id="filterForm">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="customerName" class="form-label fw-bold">Business/Customer</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-building"></i></span>
                                    <input type="text" class="form-control" id="customerName" name="customerName" 
                                           value="@ViewBag.CurrentFilter" placeholder="Search business or customer...">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="dateFrom" class="form-label fw-bold">Date From</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                    <input type="date" class="form-control" id="dateFrom" name="dateFrom" value="@ViewBag.CurrentDateFrom">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="dateTo" class="form-label fw-bold">Date To</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                    <input type="date" class="form-control" id="dateTo" name="dateTo" value="@ViewBag.CurrentDateTo">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="status" class="form-label fw-bold">Status</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-check-circle"></i></span>
                                    <select class="form-select" id="status" name="status">
                                        <option value="">All</option>
                                        <option value="VALIDATED" selected="@(ViewBag.CurrentStatus == "VALIDATED")">Validated</option>
                                        <option value="FAILED" selected="@(ViewBag.CurrentStatus == "FAILED")">Failed</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="btn-group w-100 mt-2">
                                <button type="submit" class="btn btn-primary" id="filterButton">
                                    <i class="fas fa-filter me-1"></i> Filter
                                </button>
                                <button type="button" class="btn btn-secondary" id="resetButton">
                                    <i class="fas fa-sync-alt me-1"></i> Reset
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Hidden sort and pagination parameters -->
                    <input type="hidden" name="sortOrder" id="sortOrderInput" value="@ViewBag.CurrentSort">
                    <input type="hidden" name="page" id="pageInput" value="@currentPage">
                    <input type="hidden" name="pageSize" value="@pageSize">
                </form>
                
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>
                                    <a href="javascript:void(0)" onclick="changeSort('@ViewBag.NumberSortParam')">
                                        Invoice No 
                                        @if (ViewBag.CurrentSort == "number")
                                        {
                                            <i class="fas fa-sort-up"></i>
                                        }
                                        else if (ViewBag.CurrentSort == "number_desc")
                                        {
                                            <i class="fas fa-sort-down"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-sort text-muted"></i>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="javascript:void(0)" onclick="changeSort('@ViewBag.DateSortParam')">
                                        Date
                                        @if (ViewBag.CurrentSort == "date")
                                        {
                                            <i class="fas fa-sort-up"></i>
                                        }
                                        else if (ViewBag.CurrentSort == "date_desc")
                                        {
                                            <i class="fas fa-sort-down"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-sort text-muted"></i>
                                        }
                                    </a>
                                </th>
                                @if (isAdmin)
                                {
                                    <th>
                                        <a href="javascript:void(0)" onclick="changeSort('@ViewBag.BusinessSortParam')">
                                            Business
                                            @if (ViewBag.CurrentSort == "business")
                                            {
                                                <i class="fas fa-sort-up"></i>
                                            }
                                            else if (ViewBag.CurrentSort == "business_desc")
                                            {
                                                <i class="fas fa-sort-down"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-sort text-muted"></i>
                                            }
                                        </a>
                                    </th>
                                }
                                <th>
                                    <a href="javascript:void(0)" onclick="changeSort('@ViewBag.CustomerSortParam')">
                                        Customer
                                        @if (ViewBag.CurrentSort == "customer")
                                        {
                                            <i class="fas fa-sort-up"></i>
                                        }
                                        else if (ViewBag.CurrentSort == "customer_desc")
                                        {
                                            <i class="fas fa-sort-down"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-sort text-muted"></i>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="javascript:void(0)" onclick="changeSort('@ViewBag.StatusSortParam')">
                                        Status
                                        @if (ViewBag.CurrentSort == "status")
                                        {
                                            <i class="fas fa-sort-up"></i>
                                        }
                                        else if (ViewBag.CurrentSort == "status_desc")
                                        {
                                            <i class="fas fa-sort-down"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-sort text-muted"></i>
                                        }
                                    </a>
                                </th>
                                <th>User</th>
                                <th>File</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(item.Number ?? "N/A")</td>
                                    <td>@item.Date.ToString("MMM dd, yyyy")</td>
                                    @if (isAdmin)
                                    {
                                        <td>@(item.Business?.Name ?? "N/A")</td>
                                    }
                                    <td>@(item.Customer ?? "N/A")</td>
                                    <td>
                                        @{
                                            string statusClass = item.Status == "VALIDATED" ? "success" : "danger";
                                        }
                                        <span class="badge bg-@statusClass">@(item.Status ?? "N/A")</span>
                                    </td>
                                    <td>@(item.Username ?? "N/A")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Filename))
                                        {
                                            <a class="btn btn-sm btn-outline-dark" target="_blank" title="File" 
                                               href="https://webvfdips.nyc3.digitaloceanspaces.com/documents/@item.Filename">
                                                <i class="fas fa-file-pdf me-1"></i> View
                                            </a>
                                        }
                                        else
                                        {
                                            <span>N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <a class="btn btn-sm btn-primary" title="View Details" href="/invoices/details/@item.Id">
                                            <i class="fas fa-eye me-1"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(isAdmin ? 8 : 7)" class="text-center py-4">
                                        <i class="fas fa-info-circle me-2 text-info"></i>No records found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div>
                            Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalRecords)) of @totalRecords entries
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0)" onclick="changePage(1)" aria-label="First">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0)" onclick="changePage(@(currentPage - 1))" aria-label="Previous">
                                        <span aria-hidden="true">&lsaquo;</span>
                                    </a>
                                </li>
                                
                                @{
                                    int startPage = Math.Max(1, currentPage - 2);
                                    int endPage = Math.Min(totalPages, startPage + 4);
                                    
                                    if (endPage - startPage < 4 && totalPages > 5)
                                    {
                                        startPage = Math.Max(1, endPage - 4);
                                    }
                                }
                                
                                @for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="javascript:void(0)" onclick="changePage(@i)">@i</a>
                                    </li>
                                }
                                
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0)" onclick="changePage(@(currentPage + 1))" aria-label="Next">
                                        <span aria-hidden="true">&rsaquo;</span>
                                    </a>
                                </li>
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="javascript:void(0)" onclick="changePage(@totalPages)" aria-label="Last">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Reset button handler
            $('#resetButton').click(function() {
                $('#customerName').val('');
                
                // Set default date range (last 7 days)
                const today = new Date();
                const lastWeek = new Date();
                lastWeek.setDate(today.getDate() - 7);
                
                $('#dateFrom').val(lastWeek.toISOString().split('T')[0]);
                $('#dateTo').val(today.toISOString().split('T')[0]);
                
                // Reset page and sort
                $('#pageInput').val(1);
                $('#sortOrderInput').val('date_desc');
                
                // Submit the form
                $('#filterForm').submit();
            });
        });
        
        // Change page number
        function changePage(page) {
            $('#pageInput').val(page);
            $('#filterForm').submit();
        }
        
        // Change sort order
        function changeSort(sortOrder) {
            $('#sortOrderInput').val(sortOrder);
            $('#pageInput').val(1); // Reset to first page when changing sort
            $('#filterForm').submit();
        }
    </script>
} 