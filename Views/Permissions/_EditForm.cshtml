@model InvoiceScanner.Models.Permission

<form id="editPermissionForm" method="post">
    <input type="hidden" asp-for="Id" />
    
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Permission Name</label>
        <input asp-for="Name" class="form-control" placeholder="Enter permission name" required />
        <span asp-validation-for="Name" class="text-danger"></span>
        <small class="form-text text-muted">Example: Module.Action</small>
    </div>
    
    <div class="mb-3">
        <label asp-for="Category" class="form-label">Category</label>
        <input asp-for="Category" class="form-control" list="categoriesList" placeholder="Enter or select category" required />
        <datalist id="categoriesList">
            @foreach (var category in ViewBag.Categories)
            {
                <option value="@category">@category</option>
            }
        </datalist>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe what this permission allows"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    
    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="submitEditForm()">Save Changes</button>
    </div>
</form> 