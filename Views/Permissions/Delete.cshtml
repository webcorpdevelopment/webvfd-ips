@model InvoiceScanner.Models.Permission

@{
    ViewData["Title"] = "Delete Permission";
}

<div class="container-fluid">
    <div class="card card-border">
        <div class="card-header py-3 bg-danger text-white">
            <h6 class="mb-0 fw-bold">Confirm Delete</h6>
        </div>
        <div class="card-body">
            <div class="alert alert-danger mb-4">
                <h5 class="alert-heading">Warning!</h5>
                <p>Are you sure you want to delete this permission? This action cannot be undone.</p>
                
                @if (ViewBag.CannotDelete != null && ViewBag.CannotDelete)
                {
                    <hr>
                    <p class="mb-0"><strong>This permission cannot be deleted because it is currently assigned to the following roles:</strong></p>
                    <ul>
                        @foreach (var role in ViewBag.RolesUsingPermission)
                        {
                            <li>@role</li>
                        }
                    </ul>
                    <p>You must remove this permission from all roles before it can be deleted.</p>
                }
            </div>
            
            <div class="row mb-4">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.Name</dd>
                        
                        <dt class="col-sm-4">Category:</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary">@Model.Category</span></dd>
                        
                        <dt class="col-sm-4">Description:</dt>
                        <dd class="col-sm-8">@Model.Description</dd>
                    </dl>
                </div>
            </div>
            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                    
                    @if (ViewBag.CannotDelete == null || !ViewBag.CannotDelete)
                    {
                        <button type="submit" class="btn btn-danger">
                            <i class="fa fa-trash"></i> Delete
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div> 