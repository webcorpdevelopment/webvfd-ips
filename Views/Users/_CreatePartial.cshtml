@model InvoiceScanner.Models.ApplicationUser

<div class="modal-header">
    <h5 class="modal-title">Create New User</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <form id="createUserForm">
        <div class="alert alert-danger validation-summary" style="display:none;">
            <ul id="validationErrors"></ul>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Full Name</label>
                <input type="text" id="createName" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Username</label>
                <input type="text" id="createUserName" class="form-control" required />
                <small class="form-text text-muted">This will be used for login purposes</small>
            </div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Email Address</label>
                <input type="email" id="createEmail" class="form-control" required />
                <small class="form-text text-muted">Login credentials will be sent to this email</small>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Role</label>
                <select id="createRole" class="form-select">
                    @foreach (var role in ViewBag.RoleList)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
        </div>
        
        @if (ViewBag.IsAdmin)
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Business</label>
                    <select id="createBusinessId" class="form-select" asp-items="@((System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.BusinessId)">
                        <option value="">-- No Business (System User) --</option>
                    </select>
                </div>
                @if (ViewData["BranchId"] != null)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Branch</label>
                        <select id="createBranchId" class="form-select" asp-items="@((System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["BranchId"])">
                            <option value="">-- Select Branch --</option>
                        </select>
                    </div>
                }
            </div>
        }
        else if (ViewData["BranchId"] != null)
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Branch</label>
                    <select id="createBranchId" class="form-select" asp-items="@((System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["BranchId"])">
                        <option value="">-- Select Branch --</option>
                    </select>
                </div>
            </div>
        }
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="button" id="submitCreateForm" class="btn btn-primary">
        <i class="fa fa-plus-circle me-1"></i> Create User
    </button>
</div> 