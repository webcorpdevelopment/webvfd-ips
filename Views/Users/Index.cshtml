@model IEnumerable<InvoiceScanner.Models.ApplicationUser>

@{
    ViewData["Title"] = "Users";
    ViewData["Subtitle"] = "User Management";
    
    var currentFilter = ViewData["CurrentFilter"] as string;
    var roleFilter = ViewData["RoleFilter"] as string;
    var activeFilter = ViewData["ActiveFilter"] as bool?;
    
    var totalPages = ViewBag.TotalPages;
    var currentPage = ViewBag.CurrentPage;
    var totalCount = ViewBag.TotalCount;
}

<div class="container-fluid py-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
            <h5 class="mb-0 text-primary">User Management</h5>
            <button id="openCreateModal" class="btn btn-primary">
                <i class="fa fa-plus me-1"></i> Add User
            </button>
        </div>
        <div class="card-body">
            <!-- Search and Filter -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <form asp-action="Index" method="get" class="row g-3">
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                                <input type="text" class="form-control" name="searchString" value="@currentFilter" placeholder="Search by name, email, username...">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" name="roleFilter">
                                <option value="">All Roles</option>
                                @foreach (var role in ViewBag.AvailableRoles)
                                {
                                    <option value="@role" selected="@(role == roleFilter)">@role</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" name="activeFilter">
                                <option value="">All Status</option>
                                <option value="true" selected="@(activeFilter == true)">Active</option>
                                <option value="false" selected="@(activeFilter == false)">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                        </div>
                        <input type="hidden" name="page" value="1" />
                    </form>
                </div>
            </div>

            <!-- Stats -->
            <div class="alert alert-light border mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-primary rounded-pill mb-0">@totalCount</span> users found
                    </div>
                    <div>
                        <span class="text-muted">Page @currentPage of @totalPages</span>
                    </div>
                </div>
            </div>

            <!-- Users Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Branch</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.UserName</td>
                                <td>@item.Email</td>
                                <td>@string.Join(", ", item.Roles)</td>
                                <td>@(item.Branch?.BranchName ?? "-")</td>
                                <td>
                                    @if (item.Active)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <button class="edit-user btn btn-sm btn-outline-primary" data-id="@item.Id" title="Edit user">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        <button class="resend btn btn-sm btn-outline-info" data-email="@item.Email" title="Resend credentials">
                                            <i class="fa fa-envelope"></i>
                                        </button>
                                        @if (item.Active)
                                        {
                                            <button class="activate btn btn-sm btn-outline-warning" data-email="@item.Email" title="Deactivate user">
                                                <i class="fa fa-toggle-off"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="activate btn btn-sm btn-outline-success" data-email="@item.Email" title="Activate user">
                                                <i class="fa fa-toggle-on"></i>
                                            </button>
                                        }
                                        <button class="delete-user btn btn-sm btn-outline-danger" data-id="@item.Id" title="Delete user">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mt-4">
                        <!-- Previous page -->
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" 
                                   asp-action="Index" 
                                   asp-route-page="@(currentPage - 1)"
                                   asp-route-searchString="@currentFilter"
                                   asp-route-roleFilter="@roleFilter"
                                   asp-route-activeFilter="@activeFilter">
                                    <i class="fa fa-angle-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link"><i class="fa fa-angle-left"></i></span>
                            </li>
                        }

                        <!-- Page numbers -->
                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, startPage + 4);
                            
                            if (endPage - startPage < 4 && startPage > 1)
                            {
                                startPage = Math.Max(1, endPage - 4);
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchString="@currentFilter"
                                   asp-route-roleFilter="@roleFilter"
                                   asp-route-activeFilter="@activeFilter">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Next page -->
                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)"
                                   asp-route-searchString="@currentFilter"
                                   asp-route-roleFilter="@roleFilter"
                                   asp-route-activeFilter="@activeFilter">
                                    <i class="fa fa-angle-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link"><i class="fa fa-angle-right"></i></span>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Modal Container -->
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="modalContent">
            <!-- Content will be loaded dynamically -->
        </div>
    </div>
</div>

@section Scripts {
    <!-- Sweet Alerts js -->
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Anti-forgery token setup for AJAX
        const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
        
        // Create User Modal
        $("#openCreateModal").click(function() {
            $.ajax({
                url: "/Users/GetCreateForm",
                type: "GET",
                success: function(response) {
                    $("#modalContent").html(response);
                    $("#userModal").modal("show");
                    
                    // Setup business selection to update branches
                    $("#createBusinessId").change(function() {
                        const businessId = $(this).val();
                        if (businessId) {
                            // Fetch branches for selected business
                            $.ajax({
                                url: "/BusinessBranches/GetBranchesByBusiness?businessId=" + businessId,
                                type: "GET",
                                success: function(branchData) {
                                    const branchSelect = $("#createBranchId");
                                    branchSelect.empty();
                                    branchSelect.append('<option value="">-- Select Branch --</option>');
                                    
                                    if (branchData && branchData.length > 0) {
                                        $.each(branchData, function(index, branch) {
                                            branchSelect.append('<option value="' + branch.id + '">' + branch.branchName + '</option>');
                                        });
                                    }
                                },
                                error: function() {
                                    console.error("Failed to load branches for the selected business.");
                                }
                            });
                        } else {
                            // Clear branch selection
                            $("#createBranchId").empty();
                            $("#createBranchId").append('<option value="">-- Select Branch --</option>');
                        }
                    });
                    
                    // Submit create form
                    $("#submitCreateForm").click(function() {
                        submitCreateForm();
                    });
                }
            });
        });
        
        // Edit User Modal
        $(".edit-user").click(function() {
            const userId = $(this).data('id');
            
            $.ajax({
                url: "/Users/GetEditForm?id=" + userId,
                type: "GET",
                success: function(response) {
                    $("#modalContent").html(response);
                    $("#userModal").modal("show");
                    
                    // Setup business selection to update branches
                    $("#editBusinessId").change(function() {
                        const businessId = $(this).val();
                        if (businessId) {
                            // Fetch branches for selected business
                            $.ajax({
                                url: "/BusinessBranches/GetBranchesByBusiness?businessId=" + businessId,
                                type: "GET",
                                success: function(branchData) {
                                    const branchSelect = $("#editBranchId");
                                    branchSelect.empty();
                                    branchSelect.append('<option value="">-- Select Branch --</option>');
                                    
                                    if (branchData && branchData.length > 0) {
                                        $.each(branchData, function(index, branch) {
                                            branchSelect.append('<option value="' + branch.id + '">' + branch.branchName + '</option>');
                                        });
                                    }
                                },
                                error: function() {
                                    console.error("Failed to load branches for the selected business.");
                                }
                            });
                        } else {
                            // Clear branch selection
                            $("#editBranchId").empty();
                            $("#editBranchId").append('<option value="">-- Select Branch --</option>');
                        }
                    });
                    
                    // Submit edit form
                    $("#submitEditForm").click(function() {
                        // Get form values
                        const userId = $("#editId").val();
                        const name = $("#editName").val();
                        const userName = $("#editUserName").val();
                        const email = $("#editEmail").val();
                        
                        // Handle the case when role dropdown is disabled for administrators
                        let role = $("#editRole").val();
                        if ($("#editRole").prop("disabled") && $("#editRoleHidden").length) {
                            role = $("#editRoleHidden").val();
                        }
                        
                        const branchId = $("#editBranchId").length ? $("#editBranchId").val() : null;
                        const active = $("#editActive").length ? $("#editActive").is(":checked") : true;
                        
                        // Validate form
                        let isValid = true;
                        const errors = [];
                        
                        if (!name) {
                            isValid = false;
                            errors.push("Name is required");
                        }
                        
                        if (!userName) {
                            isValid = false;
                            errors.push("Username is required");
                        }
                        
                        if (!email) {
                            isValid = false;
                            errors.push("Email is required");
                        } else if (!isValidEmail(email)) {
                            isValid = false;
                            errors.push("Email format is invalid");
                        }
                        
                        if (!isValid) {
                            // Show validation errors
                            const errorList = $("#editValidationErrors");
                            errorList.empty();
                            
                            errors.forEach(error => {
                                errorList.append("<li>" + error + "</li>");
                            });
                            
                            $("#editUserForm .validation-summary").show();
                            return;
                        }
                        
                        // Submit form via AJAX
                        $.ajax({
                            url: "/Users/Edit",
                            type: "POST",
                            data: JSON.stringify({
                                Id: userId,
                                Name: name,
                                UserName: userName,
                                Email: email,
                                Role: role,
                                BranchId: branchId,
                                BusinessId: $("#editBusinessId").length ? $("#editBusinessId").val() : null,
                                Active: active
                            }),
                            contentType: "application/json",
                            dataType: "json",
                            headers: {
                                "RequestVerificationToken": antiForgeryToken
                            },
                            success: function(response) {
                                if (response.success) {
                                    // Close modal and refresh the page
                                    $("#userModal").modal("hide");
                                    
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'User Updated',
                                        text: response.message,
                                        confirmButtonColor: '#3085d6'
                                    }).then(() => {
                                        location.reload();
                                    });
                                } else {
                                    // Show error
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: response.message,
                                        confirmButtonColor: '#e85b73'
                                    });
                                    
                                    // Keep modal open and show validation errors
                                    const errorList = $("#editValidationErrors");
                                    errorList.empty();
                                    errorList.append("<li>" + response.message + "</li>");
                                    $("#editUserForm .validation-summary").show();
                                }
                            },
                            error: function(xhr, status, error) {
                                // Show error
                                let errorMessage = "An error occurred while updating the user.";
                                if (xhr.responseJSON && xhr.responseJSON.message) {
                                    errorMessage = xhr.responseJSON.message;
                                }
                                
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: errorMessage,
                                    confirmButtonColor: '#e85b73'
                                });
                                
                                // Keep modal open and show validation errors
                                const errorList = $("#editValidationErrors");
                                errorList.empty();
                                errorList.append("<li>" + errorMessage + "</li>");
                                $("#editUserForm .validation-summary").show();
                            }
                        });
                    });
                }
            });
        });
        
        // Delete User Modal
        $(".delete-user").click(function() {
            const userId = $(this).data('id');
            
            $.ajax({
                url: "/Users/Delete?id=" + userId,
                type: "GET",
                success: function(response) {
                    $("#modalContent").html(response);
                    $("#userModal").modal("show");
                    
                    // Submit delete form
                    $("#submitDeleteForm").click(function() {
                        submitDeleteForm();
                    });
                }
            });
        });
        
        // Submit Create Form
        function submitCreateForm() {
            // Basic validation
            let isValid = true;
            const errors = [];
            
            const name = $("#createName").val();
            const userName = $("#createUserName").val();
            const email = $("#createEmail").val();
            
            if (!name) {
                isValid = false;
                errors.push("Name is required");
            }
            
            if (!userName) {
                isValid = false;
                errors.push("Username is required");
            }
            
            if (!email) {
                isValid = false;
                errors.push("Email is required");
            } else if (!isValidEmail(email)) {
                isValid = false;
                errors.push("Email format is invalid");
            }
            
            if (!isValid) {
                // Show validation errors
                $("#validationErrors").empty();
                errors.forEach(error => {
                    $("#validationErrors").append("<li>" + error + "</li>");
                });
                $(".validation-summary").show();
                return;
            }
            
            const userData = {
                Name: name,
                UserName: userName,
                Email: email,
                Role: $("#createRole").val(),
                BranchId: $("#createBranchId").val() || null,
                BusinessId: $("#createBusinessId").length ? $("#createBusinessId").val() : null
            };
            
            $.ajax({
                url: "/Users/Create",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(userData),
                headers: {
                    "RequestVerificationToken": antiForgeryToken
                },
                beforeSend: function() {
                    Swal.fire({
                        title: 'Processing...',
                        text: 'Creating user, please wait',
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        willOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function(response) {
                    Swal.close();
                    
                    if (response.success) {
                        $("#userModal").modal("hide");
                        Swal.fire({
                            title: "Success!",
                            text: response.message,
                            icon: "success",
                            confirmButtonColor: "#5b73e8"
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        // Keep modal open and show error
                        Swal.fire({
                            title: "Error!",
                            text: response.message,
                            icon: "error",
                            confirmButtonColor: "#e85b73"
                        });
                        
                        // Display validation errors in the form
                        $("#validationErrors").empty();
                        if (response.errors && response.errors.length > 0) {
                            $.each(response.errors, function(index, error) {
                                $("#validationErrors").append("<li>" + error + "</li>");
                            });
                        } else {
                            $("#validationErrors").append("<li>" + response.message + "</li>");
                        }
                        $(".validation-summary").show();
                    }
                },
                error: function(xhr, status, error) {
                    Swal.close();
                    
                    console.error("Error details:", xhr, status, error);
                    
                    // Keep modal open and show error
                    let errorMessage = "An error occurred while processing your request.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    
                    Swal.fire({
                        title: "Error!",
                        text: errorMessage,
                        icon: "error",
                        confirmButtonColor: "#e85b73"
                    });
                    
                    $("#validationErrors").empty();
                    $("#validationErrors").append("<li>" + errorMessage + "</li>");
                    $(".validation-summary").show();
                }
            });
        }
        
        // Email validation helper
        function isValidEmail(email) {
            // Safe email validation without using regex directly in Razor
            if (!email) return false;
            const atIndex = email.indexOf('@@');
            if (atIndex < 1) return false; // Must have content before @@
            const dotIndex = email.lastIndexOf('.');
            // Must have @@ before the last dot, and domain after dot
            return dotIndex > atIndex + 1 && dotIndex < email.length - 1;
        }
        
        // Submit Delete Form
        function submitDeleteForm() {
            const userData = {
                Id: $("#deleteId").val()
            };
            
            $.ajax({
                url: "/Users/DeleteConfirmed",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(userData),
                headers: {
                    "RequestVerificationToken": antiForgeryToken
                },
                beforeSend: function() {
                    Swal.fire({
                        title: 'Processing...',
                        text: 'Deactivating user, please wait',
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        willOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function(response) {
                    $("#userModal").modal("hide");
                    
                    if (response.success) {
                        Swal.fire({
                            title: "Success!",
                            text: response.message,
                            icon: "success",
                            confirmButtonColor: "#5b73e8"
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            title: "Error!",
                            text: response.message,
                            icon: "error",
                            confirmButtonColor: "#e85b73"
                        });
                    }
                },
                error: function() {
                    $("#userModal").modal("hide");
                    Swal.fire({
                        title: "Error!",
                        text: "An error occurred while processing your request.",
                        icon: "error",
                        confirmButtonColor: "#e85b73"
                    });
                }
            });
        }
        
        // Resend Credentials
        $(".resend").click(function () {
            var email = $(this).data('email');
            
            Swal.fire({
                title: 'Confirm',
                text: 'Are you sure you want to resend credentials to ' + email + '?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#5b73e8',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, resend'
            }).then((result) => {
                if (result.isConfirmed) {
                    jQuery.ajax({
                        url: "/users/resendcredentials?email=" + email,
                        type: 'GET',
                        beforeSend: function() {
                            Swal.fire({
                                title: 'Processing...',
                                text: 'Please wait',
                                allowOutsideClick: false,
                                showConfirmButton: false,
                                willOpen: () => {
                                    Swal.showLoading();
                                }
                            });
                        },
                        success: function (data) {
                            if(data.success){
                                Swal.fire({ 
                                    title: "Success!", 
                                    text: data.message, 
                                    icon: "success", 
                                    confirmButtonColor: "#5b73e8" 
                                });
                            }
                            else{
                                Swal.fire({ 
                                    title: "Error!", 
                                    text: data.message, 
                                    icon: "error", 
                                    confirmButtonColor: "#e85b73" 
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({ 
                                title: "Error!", 
                                text: "An error occurred while processing your request.", 
                                icon: "error", 
                                confirmButtonColor: "#e85b73" 
                            });
                        }
                    });
                }
            });
        });

        // Activate/Deactivate User
        $(".activate").click(function () {
            var email = $(this).data('email');
            var action = $(this).find('i').hasClass('fa-toggle-off') ? 'deactivate' : 'activate';
            
            Swal.fire({
                title: 'Confirm',
                text: 'Are you sure you want to ' + action + ' this user?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#5b73e8',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, proceed'
            }).then((result) => {
                if (result.isConfirmed) {
                    jQuery.ajax({
                        url: "/users/activate?email=" + email,
                        type: 'GET',
                        beforeSend: function() {
                            Swal.fire({
                                title: 'Processing...',
                                text: 'Please wait',
                                allowOutsideClick: false,
                                showConfirmButton: false,
                                willOpen: () => {
                                    Swal.showLoading();
                                }
                            });
                        },
                        success: function (data) {
                            if(data.success){
                                Swal.fire({ 
                                    title: "Success!", 
                                    text: data.message, 
                                    icon: "success", 
                                    confirmButtonColor: "#5b73e8" 
                                }).then(() => {
                                    location.reload();
                                });
                            }
                            else{
                                Swal.fire({ 
                                    title: "Error!", 
                                    text: data.message, 
                                    icon: "error", 
                                    confirmButtonColor: "#e85b73" 
                                }).then(() => {
                                    location.reload();
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({ 
                                title: "Error!", 
                                text: "An error occurred while processing your request.", 
                                icon: "error", 
                                confirmButtonColor: "#e85b73" 
                            });
                        }
                    });
                }
            });
        });
    </script>
}

