@model InvoiceScanner.Models.ApplicationUser

<div class="modal-header bg-danger text-white">
    <h5 class="modal-title">Confirm Deletion</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div class="alert alert-warning">
        <i class="fa fa-exclamation-triangle me-2"></i>
        Are you sure you want to deactivate this user? This action can be reversed later.
    </div>
    
    <form id="deleteUserForm">
        <input type="hidden" id="deleteId" value="@Model.Id" />
        
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <h6 class="text-muted small">FULL NAME</h6>
                    <p class="fs-5">@Model.Name</p>
                </div>
                
                <div class="mb-3">
                    <h6 class="text-muted small">USERNAME</h6>
                    <p class="fs-5">@Model.UserName</p>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="mb-3">
                    <h6 class="text-muted small">EMAIL</h6>
                    <p class="fs-5">@Model.Email</p>
                </div>
                
                <div class="mb-3">
                    <h6 class="text-muted small">ROLE</h6>
                    <p class="fs-5">
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }
                    </p>
                </div>
            </div>
        </div>
        
        @if (Model.Branch != null)
        {
            <div class="mb-3">
                <h6 class="text-muted small">BRANCH</h6>
                <p class="fs-5">@Model.Branch.BranchName</p>
            </div>
        }
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <i class="fa fa-times me-1"></i> Cancel
    </button>
    <button type="button" id="submitDeleteForm" class="btn btn-danger">
        <i class="fa fa-trash me-1"></i> Deactivate User
    </button>
</div> 