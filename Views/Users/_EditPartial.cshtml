@model InvoiceScanner.Models.ApplicationUser

<div class="modal-header">
    <h5 class="modal-title">Edit User</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <form id="editUserForm">
        <input type="hidden" id="editId" value="@Model.Id" />
        <div class="alert alert-danger validation-summary" style="display:none;">
            <ul id="editValidationErrors"></ul>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Full Name</label>
                <input type="text" id="editName" class="form-control" value="@Model.Name" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Username</label>
                <input type="text" id="editUserName" class="form-control" value="@Model.UserName" required />
            </div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Email Address</label>
                <input type="email" id="editEmail" class="form-control" value="@Model.Email" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Role</label>
                <select id="editRole" class="form-select" @(ViewBag.IsEditingAdministrator == true ? "disabled" : "")>
                    @foreach (var role in ViewBag.RoleList)
                    {
                        <option value="@role" selected="@(Model.Roles.Contains(role))">@role</option>
                    }
                </select>
                @if (ViewBag.IsEditingAdministrator == true)
                {
                    <small class="form-text text-warning">Administrator role cannot be changed</small>
                    <input type="hidden" id="editRoleHidden" value="Administrator" />
                }
            </div>
        </div>
        
        @if (ViewBag.IsAdmin)
        {
            <div class="row mb-3">
                @if (ViewData["BusinessId"] != null)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Business</label>
                        <select id="editBusinessId" class="form-select" asp-items="@((System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.BusinessId)">
                            <option value="">-- No Business (System User) --</option>
                        </select>
                    </div>
                }
                @if (ViewData["BranchId"] != null)
                {
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Branch</label>
                        <select id="editBranchId" class="form-select" asp-items="@((System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["BranchId"])">
                            <option value="">-- Select Branch --</option>
                        </select>
                    </div>
                }
            </div>
        }
        else if (ViewData["BranchId"] != null)
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Branch</label>
                    <select id="editBranchId" class="form-select" asp-items="@((System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["BranchId"])">
                        <option value="">-- Select Branch --</option>
                    </select>
                </div>
            </div>
        }
        
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Status</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="editActive" checked="@Model.Active">
                    <label class="form-check-label">Active Account</label>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="button" id="submitEditForm" class="btn btn-primary">
        <i class="fa fa-save me-1"></i> Save Changes
    </button>
</div> 