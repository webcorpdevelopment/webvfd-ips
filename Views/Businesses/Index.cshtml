@model IEnumerable<InvoiceScanner.Controllers.BusinessViewModel>

@{
    ViewData["Title"] = "Registered Businesses";
}

<div class="card">
    <div class="card-body">
        <div class="text-end">
            <a asp-action="Create" class="btn btn-success">Create New</a>
        </div>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.TIN)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.VRN)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NumberOfUsers)
                    </th>
                    <th class="text-end">Total invoices</th>
                    <th class="text-end">Successful invoices</th>
                    <th class="text-end">Failed invoices</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.TIN)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.VRN)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.NumberOfUsers)
                        </td>
                        <td class="text-end">@item.TotalInvoices.ToString("#,##0")</td>
                        <td class="text-end">@item.TotalSuccessful.ToString("#,##0")</td>
                        <td class="text-end">@item.TotalFailures.ToString("#,##0")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
