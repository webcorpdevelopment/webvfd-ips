@model List<InvoiceScanner.Models.Backup>
@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">System Settings</h5>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <ul class="nav nav-tabs" id="settingsTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="backup-tab" data-bs-toggle="tab" data-bs-target="#backup" type="button" role="tab" aria-controls="backup" aria-selected="true">Database Backup</button>
                        </li>
                    </ul>

                    <div class="tab-content pt-3" id="settingsTabsContent">
                        <div class="tab-pane fade show active" id="backup" role="tabpanel" aria-labelledby="backup-tab">
                            <div class="row mb-3">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="mb-0">Database Backups</h6>
                                        <form asp-action="CreateBackup" method="post">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fa fa-download me-2"></i>Create Backup
                                            </button>
                                        </form>
                                    </div>
                                    
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Filename</th>
                                                    <th>Created At</th>
                                                    <th>Created By</th>
                                                    <th>Size</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Any())
                                                {
                                                    foreach (var backup in Model)
                                                    {
                                                        <tr>
                                                            <td>@backup.FileName</td>
                                                            <td>@backup.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                                            <td>@backup.CreatedBy</td>
                                                            <td>@(backup.FileSize / 1024) KB</td>
                                                            <td>
                                                                <div class="btn-group">
                                                                    <a asp-action="Download" asp-route-id="@backup.Id" class="btn btn-sm btn-primary">
                                                                        <i class="fa fa-download"></i>
                                                                    </a>
                                                                    <form asp-action="Delete" asp-route-id="@backup.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this backup?');" style="display: inline-block;">
                                                                        <button type="submit" class="btn btn-sm btn-danger">
                                                                            <i class="fa fa-trash"></i>
                                                                        </button>
                                                                    </form>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="5" class="text-center">No backups available.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    
                                    <div class="alert alert-info mt-3">
                                        <h6>About Database Backups</h6>
                                        <p class="mb-0">Database backups are essential for protecting your data. We recommend creating regular backups to prevent data loss.</p>
                                        <ul class="mt-2 mb-0">
                                            <li>Backups are stored on the server in the Backups directory</li>
                                            <li>You can download backups for offline storage</li>
                                            <li>Backups include all database tables and data</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            // Handle tab state persistence
            var activeTab = localStorage.getItem('settingsActiveTab');
            if (activeTab) {
                $('#settingsTabs button[data-bs-target="' + activeTab + '"]').tab('show');
            }
            
            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                var targetTab = $(e.target).data('bs-target');
                localStorage.setItem('settingsActiveTab', targetTab);
            });
        });
    </script>
} 